                                /* 0178 */  0x5F, 0x53, 0x42, 0x2E, 0x50, 0x43, 0x30, 0x30,  // _SB.PC00
                                /* 0180 */  0x2E, 0x58, 0x48, 0x43, 0x49, 0x2E, 0x52, 0x48,  // .XHCI.RH
                                /* 0188 */  0x55, 0x42, 0x2E, 0x56, 0x47, 0x50, 0x4F, 0x00,  // UB.VGPO.
                                /* 0190 */  0x8C, 0x2F, 0x00, 0x01, 0x01, 0x01, 0x00, 0x00,  // ./......
