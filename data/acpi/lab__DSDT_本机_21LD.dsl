                        Return (Zero)
                    }
                    ElseIf ((ToInteger (Arg2) == 0x05))
                    {
                        ^^PC00.LPCB.EC0.SPMT = Zero
                        Return (Zero)
                    }
                    Else
                    {
                        Return (One)
                    }
                }
            }

