                }
                ElseIf ((\_SB.PC00.LPCB.EC0.NVD1 == 0x04))
                {
                    Notify (\_SB.PC00.RP10.PXSX, 0xD4) // Hardware-Specific
                }
                ElseIf ((\_SB.PC00.LPCB.EC0.NVD1 == 0x05))
                {
                    Notify (\_SB.PC00.RP10.PXSX, 0xD5) // Hardware-Specific
                }
                Else
