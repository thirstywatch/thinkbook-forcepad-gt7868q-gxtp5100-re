    Method (DGHP, 1, NotSerialized)
    {
        If ((Arg0 == One))
        {
            DGST = One
            If ((DGBS == One))
            {
                DGBS = Zero
            }

            \_SB.PC00.RP10.PXP._ON ()
            Sleep (0x64)
            Notify (\_SB.PC00.RP10.PXSX, Zero) // Bus Check
        }
        ElseIf (\_SB.PC00.RP10.PXP._STA ())
        {
            DGBS = One
        }
        Else
        {
            Notify (\_SB.PC00.RP10.PXSX, 0x03) // Eject Request
            Notify (\_SB.PC00.RP10.PXSX, Zero) // Bus Check
        }
    }

