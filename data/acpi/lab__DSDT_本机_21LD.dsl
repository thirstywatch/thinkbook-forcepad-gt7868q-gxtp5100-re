            })
            Method (_WED, 1, NotSerialized)  // _Wxx: Wake Event, xx=0x00-0xFF
            {
                If ((Arg0 == 0xD9))
                {
                    If (CondRefOf (\_SB.PC00.RP09.PXSX))
                    {
                        If ((VDID != 0xFFFF))
                        {
                            If ((DBCV == 0x03))
                            {
                                Return (One)
                            }
                            Else
                            {
                                Return (0x02)
                            }
                        }

                        Return (Zero)
                    }

                    Return (Zero)
                }
            }

            Method (WMDL, 3, NotSerialized)
            {
                If ((Arg1 == One))
                {
                    If (CondRefOf (\_SB.PC00.RP09.PXSX))
