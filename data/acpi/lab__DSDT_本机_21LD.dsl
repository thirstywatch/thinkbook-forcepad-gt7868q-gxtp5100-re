    Scope (_SB.PC00.LPCB.EC0)
    {
        Name (ACTW, Zero)
        Method (ADPW, 0, NotSerialized)
        {
            Name (ACW0, Zero)
            Name (ACW1, Zero)
            Local0 = Buffer (0x06){}
            Local1 = Buffer (0x08){}
            Local0 [Zero] = 0x45
            Local0 [One] = 0xF6
            Local1 = ERCD (Local0)
            ACW0 = DerefOf (Local1 [Zero])
            ACW1 = DerefOf (Local1 [One])
            ACTW = ((ACW1 << 0x08) + ACW0) /* \_SB_.PC00.LPCB.EC0_.ADPW.ACW0 */
        }

        Scope (\_TZ)
        {
            Device (VFAN)
            {
                Name (_HID, EisaId ("PNP0C0B") /* Fan (Thermal Solution) */)  // _HID: Hardware ID
                Name (TFST, Package (0x03)
                {
                    Zero, 
                    Zero, 
                    Zero
                })
                Method (_FST, 0, Serialized)  // _FST: Fan Status
                {
                    If ((\_SB.FANL <= One))
                    {
                        TFST [0x02] = Zero
                    }
                    ElseIf ((\_SB.FANL == 0x02))
                    {
                        TFST [0x02] = 0x09C4
                    }
                    ElseIf ((\_SB.FANL == 0x03))
                    {
                        TFST [0x02] = 0x0DAC
                    }
                    ElseIf ((\_SB.FANL == 0x04))
                    {
                        TFST [0x02] = 0x1194
                    }

                    If ((DerefOf (TFST [0x02]) > Zero))
                    {
                        TFST [One] = One
                    }
                    Else
                    {
                        TFST [One] = Zero
                    }

                    Return (TFST) /* \_TZ_.VFAN.TFST */
                }

                Method (_DSM, 4, Serialized)  // _DSM: Device-Specific Method
                {
                    If ((Arg0 == ToUUID ("a7611840-99fe-41ae-a488-35c75926c8eb") /* Fan Trip Points */))
                    {
                        Switch (ToInteger (Arg2))
                        {
                            Case (Zero)
                            {
                                Return (Buffer (One)
                                {
                                     0x0F                                             // .
                                })
                            }
                            Case (One)
                            {
                                Return (0x64)
                            }
                            Case (0x02)
                            {
                                Return (Zero)
                            }
                            Case (0x03)
                            {
                                Return (Package (0x04)
                                {
                                    0x07D0, 
                                    0x0BB8, 
                                    0x0FA0, 
                                    0x270F
                                })
                            }
                            Default
                            {
                                Return (Buffer (One)
                                {
                                     0x00                                             // .
                                })
                            }

                        }
                    }
                    Else
                    {
                        Return (Buffer (One)
                        {
                             0x00                                             // .
                        })
                    }
                }
            }
        }

        Method (_Q47, 0, NotSerialized)  // _Qxx: EC Query, xx=0x00-0xFF
        {
            Debug = "Q47 trigger"
            If ((^^^^WMI5.DSIF == One))
            {
                If (((MLR1 > Zero) && (MLR1 != ^^^^WMI5.LPWR)))
                {
                    ^^^^WMI5.SDRF = Zero
                    If ((MLR1 >= 0x82))
                    {
                        If ((^^^^WMI5.LPWR >= 0x82))
                        {
                            ^^^^WMI5.SDRF = One
                        }
                        Else
                        {
                            ^^^^WMI5.SDRF = One
                        }
                    }
                    ElseIf ((^^^^WMI5.LPWR >= 0x82))
                    {
                        ^^^^WMI5.SDRF = One
                    }
                    Else
                    {
                    }

                    ^^^^WMI5.LPWR = MLR1 /* \_SB_.PC00.LPCB.EC0_.MLR1 */
                    If (((^^^^WMI5.OVTP == Zero) || (^^^^WMI5.SDRF == One)))
                    {
                        MBGS ("Notify D0.")
                        Notify (WMI5, 0xD0) // Hardware-Specific
                    }
                }

                If (((MLR2 > Zero) && (MLR2 != ^^^^WMI5.LSCN)))
                {
                    MBGS ("Notify D1.")
                    ^^^^WMI5.LSCN = MLR2 /* \_SB_.PC00.LPCB.EC0_.MLR2 */
                    Notify (WMI5, 0xD1) // Hardware-Specific
                }
            }
        }

        Method (_Q48, 0, NotSerialized)  // _Qxx: EC Query, xx=0x00-0xFF
        {
            Debug = "Q48 trigger"
            If (((^^^^WMI5.DSIF == Zero) || (MOFD == One)))
            {
                If ((MMCM == Zero))
                {
                    CPL1 = (PL1V * 0x08)
                    CPL2 = (PL2V * 0x08)
                }
            }
        }

        Method (_Q50, 0, NotSerialized)  // _Qxx: EC Query, xx=0x00-0xFF
        {
            Debug = "Q50 trigger"
            MBGS ("Notify D2.")
            Notify (WMI5, 0xD2) // Hardware-Specific
        }
    }

    Scope (_SB.PC00.RP10.PXSX)
    {
