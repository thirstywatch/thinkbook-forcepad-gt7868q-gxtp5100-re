            Method (_WED, 1, NotSerialized)  // _Wxx: Wake Event, xx=0x00-0xFF
            {
                If ((Arg0 == 0xD0))
                {
                    Return (^^PC00.LPCB.EC0.MLR1) /* \_SB_.PC00.LPCB.EC0_.MLR1 */
                }

                If ((Arg0 == 0xD1))
                {
                    Return (^^PC00.LPCB.EC0.MLR2) /* \_SB_.PC00.LPCB.EC0_.MLR2 */
                }

                If ((Arg0 == 0xD2))
                {
                    Name (BUFF, Buffer (0x08)
                    {
                         0x00                                             // .
                    })
                    CreateByteField (BUFF, Zero, RPTY)
                    CreateByteField (BUFF, 0x04, RPDT)
                    RPTY = ^^PC00.LPCB.EC0.RDTP /* \_SB_.PC00.LPCB.EC0_.RDTP */
                    RPDT = ^^PC00.LPCB.EC0.RDDT /* \_SB_.PC00.LPCB.EC0_.RDDT */
                    If ((^^PC00.LPCB.EC0.RDTP == 0x03))
                    {
                        If ((^^PC00.LPCB.EC0.RDDT == One))
                        {
                            OVTP = One
                        }
                        Else
                        {
                            OVTP = Zero
                        }
                    }

                    Return (BUFF) /* \_SB_.WMI5._WED.BUFF */
                }

                If ((Arg0 == 0xDE))
                {
                    Return (^^PC00.LPCB.EC0.APSB) /* \_SB_.PC00.LPCB.EC0_.APSB */
                }
            }

