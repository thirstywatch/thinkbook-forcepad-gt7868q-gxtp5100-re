                                /* 0140 */  0x00, 0x00, 0x00, 0x06, 0x00, 0x5C, 0x5F, 0x53,  // .....\_S
                                /* 0148 */  0x42, 0x2E, 0x50, 0x43, 0x30, 0x30, 0x2E, 0x58,  // B.PC00.X
                                /* 0150 */  0x48, 0x43, 0x49, 0x2E, 0x52, 0x48, 0x55, 0x42,  // HCI.RHUB
                                /* 0158 */  0x2E, 0x56, 0x47, 0x50, 0x4F, 0x00, 0x8C, 0x2F,  // .VGPO../
                                /* 0160 */  0x00, 0x01, 0x01, 0x01, 0x00, 0x00, 0x00, 0x00,  // ........
