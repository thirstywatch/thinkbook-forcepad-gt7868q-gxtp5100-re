                                /* 00B0 */  0x5F, 0x53, 0x42, 0x2E, 0x50, 0x43, 0x30, 0x30,  // _SB.PC00
                                /* 00B8 */  0x2E, 0x58, 0x48, 0x43, 0x49, 0x2E, 0x52, 0x48,  // .XHCI.RH
                                /* 00C0 */  0x55, 0x42, 0x2E, 0x56, 0x47, 0x50, 0x4F, 0x00,  // UB.VGPO.
                                /* 00C8 */  0x8C, 0x2F, 0x00, 0x01, 0x01, 0x01, 0x00, 0x00,  // ./......
                                /* 00D0 */  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x17, 0x00,  // ........
                                /* 00D8 */  0x00, 0x19, 0x00, 0x32, 0x00, 0x00, 0x00, 0x04,  // ...2....
                                /* 00E0 */  0x00, 0x5C, 0x5F, 0x53, 0x42, 0x2E, 0x50, 0x43,  // .\_SB.PC
                                /* 00E8 */  0x30, 0x30, 0x2E, 0x58, 0x48, 0x43, 0x49, 0x2E,  // 00.XHCI.
                                /* 00F0 */  0x52, 0x48, 0x55, 0x42, 0x2E, 0x56, 0x47, 0x50,  // RHUB.VGP
                                /* 00F8 */  0x4F, 0x00, 0x8C, 0x2F, 0x00, 0x01, 0x01, 0x01,  // O../....
                                /* 0100 */  0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,  // ........
                                /* 0108 */  0x17, 0x00, 0x00, 0x19, 0x00, 0x32, 0x00, 0x00,  // .....2..
                                /* 0110 */  0x00, 0x05, 0x00, 0x5C, 0x5F, 0x53, 0x42, 0x2E,  // ...\_SB.
                                /* 0118 */  0x50, 0x43, 0x30, 0x30, 0x2E, 0x58, 0x48, 0x43,  // PC00.XHC
                                /* 0120 */  0x49, 0x2E, 0x52, 0x48, 0x55, 0x42, 0x2E, 0x56,  // I.RHUB.V
                                /* 0128 */  0x47, 0x50, 0x4F, 0x00, 0x8C, 0x2F, 0x00, 0x01,  // GPO../..
                                /* 0130 */  0x01, 0x01, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,  // ........
