            })
            Method (WMSR, 3, NotSerialized)
            {
                If ((Arg1 == One))
                {
                    Return (^^PC00.LPCB.EC0.LSRN) /* \_SB_.PC00.LPCB.EC0_.LSRN */
                }

                If ((Arg1 == 0x02))
                {
                    ^^PC00.LPCB.EC0.LESR = One
                    Return (One)
                }

                If ((Arg1 == 0x03))
                {
                    ^^PC00.LPCB.EC0.LESR = Zero
                    Return (One)
                }

                If ((Arg1 == 0x04))
                {
                    Return (0x02)
                }
            }

            Method (_WED, 1, NotSerialized)  // _Wxx: Wake Event, xx=0x00-0xFF
            {
                Return (One)
            }

